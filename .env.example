# Copy these into Vercel: Project → Settings → Environment Variables.

# Your live domain, without a trailing slash. Used for canonical URLs, the sitemap and social previews.
# If you leave it empty, the Vercel production URL (your-project.vercel.app) is used.
NEXT_PUBLIC_SITE_URL=https://aurahive.ae

# Contact form delivery: set up at least one of these, or the live form asks visitors to email you instead.

# Option 1: email each enquiry to your inbox with Resend (resend.com, free plan available).
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@yourdomain.com
# Sender address on a domain verified in Resend. Leave empty to use Resend's test sender while setting up.
CONTACT_FROM_EMAIL=Aura Hive <website@aurahive.ae>

# Option 2: send each enquiry to a Zapier, Make or n8n webhook (then on to WhatsApp, HubSpot, Sheets…).
CONTACT_WEBHOOK_URL=
